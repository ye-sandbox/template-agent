# Secrets — never commit
.env
.env.*
!.env.example

# High-frequency junk (safe before you pick a stack)
node_modules/
.venv/
venv/
__pycache__/
dist/
build/
*.log

# OS / IDE / agent scratch
.DS_Store
Thumbs.db
.idea/
.vscode/
.agent/scratch/
.agent/.cache/
.worktrees/
.gemini/
.claude/
.maestri/
.multigravity/
*.tsbuildinfo

# dev-harness local-first state (queue contracts live in git; runtime state does not)
.harness/queue/done/
.harness/queue/escalated/
.harness/worktrees/

# --- Python ---
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/

# --- Local Data & Models ---
data/
models/
*.sqlite
*.db
