# ==============================================================================
# Exemplo Canônico de Orquestração de Serviços (Docker Compose)
# Copie este arquivo para compose.yaml e adapte conforme a necessidade do projeto
# ==============================================================================
services:
  # ----------------------------------------------------------------------------
  # VictoriaLogs — Mecanismo de Ingestão e Armazenamento de Logs
  # ----------------------------------------------------------------------------
  victorialogs:
    image: victoriametrics/victoria-logs:v1.1.0
    container_name: victorialogs
    restart: unless-stopped
    command:
      - "-storageDataPath=/vlogs-data"
      - "-httpListenAddr=:9428"
    ports:
      - "127.0.0.1:${VICTORIALOGS_PORT:-9428}:9428"
    volumes:
      - victorialogs_data:/vlogs-data
    networks:
      - monitoring_internal
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:9428/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1024M

  # ----------------------------------------------------------------------------
  # Uptime Kuma — Dashboard de Monitoramento de Uptime e Status Pages
  # ----------------------------------------------------------------------------
  uptime-kuma:
    image: louislam/uptime-kuma:1.23.13
    container_name: uptime-kuma
    restart: unless-stopped
    ports:
      - "${UPTIME_KUMA_PORT:-3001}:3001"
    volumes:
      - uptime_kuma_data:/app/data
    networks:
      - proxy_public
      - monitoring_internal
    healthcheck:
      test: ["CMD-SHELL", "node extra/healthcheck.js || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M

# ------------------------------------------------------------------------------
# Redes Segregadas
# ------------------------------------------------------------------------------
networks:
  proxy_public:
    driver: bridge
  monitoring_internal:
    driver: bridge

# ------------------------------------------------------------------------------
# Volumes Persistentes Gerenciados
# ------------------------------------------------------------------------------
volumes:
  victorialogs_data:
    driver: local
  uptime_kuma_data:
    driver: local
