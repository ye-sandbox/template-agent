# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — Infrastructure & Core Services
# ==============================================================================
# Copy this file to `.env` and customize variables for your host environment:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# Container Runtime Timezone
TZ=America/Sao_Paulo

# Root path for local data persistence
DATA_PATH=./volumes

# ------------------------------------------------------------------------------
# External Service Port Mappings
# ------------------------------------------------------------------------------
VICTORIALOGS_PORT=9428
UPTIME_KUMA_PORT=3001
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# Service Secrets & Admin Credentials (NEVER commit real values to Git)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=change_this_password_in_production
API_SECRET_TOKEN=generate_a_random_token_here
