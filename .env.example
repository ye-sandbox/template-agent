# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — Blackbox & Reverse Engineering
# ==============================================================================
# Copy this file to `.env` and fill in your local credentials:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# Target System Base URL
TARGET_BASE_URL="https://legacy-portal.example.com/api"

# Access Credentials (for automated authentication flows)
TARGET_USERNAME="example_user"
TARGET_PASSWORD="secure_password_here"

# Session Cookie / Manual Token (for rapid curl probing or scratch scripts)
TARGET_SESSION_COOKIE=""
TARGET_CSRF_HASH=""

# Network & Resilience Tuning
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
REQUEST_DELAY_MS=500
PROXY_URL=""

# Client Headers & Fingerprinting
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
