# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to `.env` and fill in your actual environment values:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# [Primary Service / Application Runtime]
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production

# [Database & Persistence]
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# [Queue / Cache / Redis Broker]
REDIS_URL=redis://localhost:6379/0

# [External Services / Integrations]
# EXTERNAL_API_KEY=your_key_here
# EXTERNAL_API_URL=https://api.example.com
