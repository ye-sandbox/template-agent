# ==============================================================================
# Configuração de Ambiente para Engenharia Reversa e Integração Blackbox
# Copie este arquivo para .env e preencha com seus dados locais: cp .env.example .env
# ==============================================================================

# URL Base do Sistema-Alvo
TARGET_BASE_URL="https://sei.orgao.gov.br/sei"

# Credenciais de Acesso (para fluxos com login automatizado)
TARGET_USERNAME="usuario_exemplo"
TARGET_PASSWORD="senha_segura_aqui"

# Cookie de Sessão / Token Manual (para testes rápidos via cURL ou scripts temporários)
TARGET_SESSION_COOKIE=""
TARGET_CSRF_HASH=""

# Configurações de Rede e Resiliência
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
REQUEST_DELAY_MS=500
PROXY_URL=""

# Headers e Identificação
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
