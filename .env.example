# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — offgrid-voice
# ==============================================================================
# Copy this file to `.env` and fill in your actual environment values:
# cp .env.example .env
#
# RULE: NEVER commit `.env` containing sensitive credentials to the repository.
# ==============================================================================

# [Primary Service / Application Runtime]
APP_ENV=development
APP_PORT=8000
WYOMING_PORT=10400
APP_SECRET_KEY=change-me-in-production

# [Vector Memory & Persistence (sqlite-vec)]
SQLITE_VEC_PATH=./data/offgrid_memory.db
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# [Audio Pipeline (CPU / 0 MB VRAM)]
STT_MODEL=whisper-large-v3-turbo
STT_QUANTIZATION=Q8_0
TTS_VOICE_PT_BR=pt_BR-faber-medium
TTS_VOICE_EN=kokoro-82m

# [LLM Gateway Integration (hydra-llm-router - OpenAI v1 Compatible)]
# Sibling Container (hydra_shared_net): http://hydra-llm-router:3000/v1
# Remote Traefik HTTPS: https://hydra-router.homelab.yegear.dev/v1
# Localhost CLI: http://127.0.0.1:3000/v1
# Discover operator-configured virtual model aliases via GET /v1/models or GET /v1/hydra/models
LLM_BASE_URL=http://hydra-llm-router:3000/v1
LLM_API_KEY=sk-replace-with-hydra-tier-token
LLM_MODEL_FAST=fast
LLM_MODEL_DEEP=deep
LLM_TIMEOUT_SECONDS=180

# [Homelab Tools & Integrations]
WHATSAPP_API_URL=http://whatsapp-api:3000
WHATSAPP_API_KEY=replace-with-whatsapp-api-key
MQTT_BROKER_URL=mqtt://localhost:1883
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-ha-long-lived-token
