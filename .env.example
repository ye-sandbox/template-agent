# ==============================================================================
# Configuração de Ambiente de Infraestrutura e Serviços
# Copie este arquivo para .env e customize as variáveis conforme seu host
# ==============================================================================

# Fuso horário dos contêineres
TZ=America/Sao_Paulo

# Caminho raiz para persistência local de dados (se aplicável)
DATA_PATH=./volumes

# ------------------------------------------------------------------------------
# Portas Externas dos Serviços
# ------------------------------------------------------------------------------
VICTORIALOGS_PORT=9428
UPTIME_KUMA_PORT=3001
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# Segredos e Senhas de Serviços (NUNCA versione valores reais no Git)
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=change_this_password_in_production
API_SECRET_TOKEN=generate_a_random_token_here
