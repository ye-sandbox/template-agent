# Baremetal & Workstation Ops Environment Variables
# Copy to .env for local configuration

# Telemetry & Observability Ingestion (Vector / VictoriaLogs)
VECTOR_ENABLED=false
VECTOR_HOST=127.0.0.1
VECTOR_HTTP_PORT=8686
SERVICE_NAME=baremetal-workstation
ENV=production

# Preferred benchmark tool: sysbench, fio, or custom
BENCHMARK_TOOL=sysbench
