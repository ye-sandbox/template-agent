# Baremetal & Workstation Ops Environment Variables
# Copy to .env for local configuration

# Telemetry & Observability Ingestion (Vector / VictoriaLogs)
VECTOR_ENABLED=false
VECTOR_HOST=127.0.0.1
VECTOR_HTTP_PORT=8686
SERVICE_NAME=baremetal-workstation
ENV=production

# Preferred benchmark tool: sysbench, fio, or custom
BENCHMARK_TOOL=sysbench

# LLM Gateway Integration (hydra-llm-router - OpenAI v1 Compatible)
# Localhost CLI: http://127.0.0.1:3000/v1 | Remote HTTPS: https://hydra-router.homelab.yegear.dev/v1
# Discover operator-configured virtual model aliases via GET /v1/models or GET /v1/hydra/models
LLM_BASE_URL=http://hydra-llm-router:3000/v1
LLM_API_KEY=sk-replace-with-hydra-tier-token
LLM_MODEL_FAST=fast
LLM_MODEL_DEEP=deep
LLM_TIMEOUT_SECONDS=180
